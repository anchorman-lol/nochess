{
  "name": "nochess",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "postinstall": "scripts/engine.sh",
    "dev": "scripts/dev.sh",
    "relay": "scripts/relay.sh relay.dev.json",
    "bot": "node tools/bot.ts",
    "review": "node tools/reviewer.ts",
    "rate": "node tools/rater.ts",
    "zapmock": "node tools/zapmock.ts",
    "build": "pnpm -r typecheck && tsc && pnpm --filter @nochess/web build",
    "typecheck": "pnpm -r typecheck && tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shots": "playwright test -c playwright.shots.config.ts",
    "check": "oxlint --deny-warnings && oxfmt --check && pnpm typecheck && vitest run && playwright test",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@nochess/core": "workspace:*",
    "chess.js": "catalog:",
    "nostr-tools": "catalog:",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@nochess/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
