{
  "name": "luft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "scripts/engine.sh",
    "dev": "scripts/dev.sh",
    "relay": "scripts/relay.sh relay.dev.json",
    "bot": "node tools/bot.ts",
    "review": "node tools/reviewer.ts",
    "rate": "node tools/rater.ts",
    "zapmock": "node tools/zapmock.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "oxlint && tsc --noEmit && vitest run && playwright test",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "chess.js": "^1.4.0",
    "light-bolt11-decoder": "^3.2.0",
    "nostr-tools": "^2.26.1",
    "stockfish": "^19.0.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
