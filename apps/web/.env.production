# Public settings of the Pages build (pnpm deploy:pages), which ignores VITE_* in the shell.
# The platform's share of zaps is zapped to VITE_PLATFORM_LUD16 as VITE_PLATFORM_PUBKEY; with
# either empty there is no share. Both are public: a key and a lightning address.
VITE_PLATFORM_PUBKEY=e79ec7ba706610be0608bd46c1b4385ecd86f89ba51dc0c556f61ec064e8e203
VITE_PLATFORM_LUD16=trimpayment17@walletofsatoshi.com
# The default share in percent, 0 to 50; empty means 15.
VITE_PLATFORM_SHARE=
# Raters whose assertions the app trusts, comma-separated hex keys: the Nochess rater on magikarp.
VITE_RATERS=b19179015020c32b081953d32677cc5ab7839fe489f362d5c9ae86f699e379a0
